# Required
DISCORD_BOT_TOKEN=
AZURE_OPENAI_API_KEY=

# Azure OpenAI inference settings
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Inkwell behavior
INKWELL_ALLOWED_CHANNELS=ask-inkwell
INKWELL_MASTER_DOCUMENT_PATH=documentation/master-training-guide.pdf
INKWELL_MAX_OUTPUT_TOKENS=700
INKWELL_TEMPERATURE=0.15
INKWELL_MAX_KNOWLEDGE_CHARS=120000
