# --- Required ---
DISCORD_BOT_TOKEN=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com

# --- Azure OpenAI ---
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Access control (this is the spend boundary) ---
# REQUIRED. Comma-separated Discord guild ids the bot will answer in.
# Unset means the bot answers nobody: it fails closed on purpose, because every
# answer costs an Azure OpenAI call.
INKWELL_ALLOWED_GUILD_IDS=
# Answer direct messages? DM authors are still verified as members of an
# allowed guild before anything is spent on them.
INKWELL_ALLOW_DMS=false

# --- Rate limits (0 disables a check) ---
INKWELL_USER_RATE_LIMIT=10
INKWELL_RATE_LIMIT_WINDOW_SECONDS=600
INKWELL_GLOBAL_RATE_LIMIT=200

# --- Bot behaviour ---
# Comma-separated channel names the bot answers in unmentioned.
INKWELL_ALLOWED_CHANNELS=ask-inkwell
# Path to the knowledge document. Defaults to docs/knowledge-base/inkwell-training-guide.md
INKWELL_MASTER_DOCUMENT_PATH=
INKWELL_MAX_OUTPUT_TOKENS=700
INKWELL_TEMPERATURE=0.15
INKWELL_MAX_KNOWLEDGE_CHARS=120000
# Optional. JSON object mapping the role placeholders used in the published
# documents to the real names and handles for your deployment, applied at
# startup. Keeps personal identities out of the repository while still giving
# members a usable mention. Example:
#   {"@server-owner": "@realhandle", "the Lead Editor": "Dana"}
INKWELL_IDENTITY_MAP=

# --- Follow-up context window ---
INKWELL_FOLLOWUP_FETCH_LIMIT=60
INKWELL_FOLLOWUP_MAX_MESSAGES=12
INKWELL_FOLLOWUP_LOOKBACK_MINUTES=90
