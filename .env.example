# --- Required ---
DISCORD_BOT_TOKEN=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://your-resource-name.openai.azure.com

# --- Azure OpenAI ---
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# --- Bot behaviour ---
# Comma-separated channel names the bot answers in unmentioned.
INKWELL_ALLOWED_CHANNELS=ask-inkwell
# Path to the knowledge document. Defaults to docs/knowledge-base/inkwell-training-guide.md
INKWELL_MASTER_DOCUMENT_PATH=
INKWELL_MAX_OUTPUT_TOKENS=700
INKWELL_TEMPERATURE=0.15
INKWELL_MAX_KNOWLEDGE_CHARS=120000

# --- Follow-up context window ---
INKWELL_FOLLOWUP_FETCH_LIMIT=60
INKWELL_FOLLOWUP_MAX_MESSAGES=12
INKWELL_FOLLOWUP_LOOKBACK_MINUTES=90
